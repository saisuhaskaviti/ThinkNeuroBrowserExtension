{
  "manifest_version": 3,
  "name": "Pause Point",
  "version": "1.0.0",
  "description": "Combats mindless scrolling by introducing intentional friction rather than a hard block.",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Pause Point Settings",
    "default_popup": "popup.html"
  }
}
