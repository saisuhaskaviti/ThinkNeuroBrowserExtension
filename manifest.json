{
  "manifest_version": 3,
  "name": "Pause Point",
  "version": "2.0.0",
  "description": "Combat mindless scrolling with intentional friction — inspired by Android 17 Pause Point.",
  "permissions": [
    "storage",
    "webNavigation",
    "tabs",
    "activeTab",
    "history",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Pause Point",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16":  "icon16.png",
    "48":  "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["timer-overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pause.html", "styles.css", "theme.js", "pause.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
